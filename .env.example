# ============================================================
# Immerse – Environment Variables
# ============================================================

# RIDB API Key (REQUIRED for live federal campground data)
# 1. Go to https://ridb.recreation.gov
# 2. Create an account / sign in
# 3. Go to your Profile → generate an API key
# 4. Paste it below
RIDB_API_KEY=your_ridb_api_key_here

# Mapbox Access Token (for maps + future drive-time)
# Free tier is plenty for development: https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Optional base URL override (usually not needed)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: future AI itinerary features
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
