# ============================================================
# Immerse – Environment Variables
# ============================================================

# Shared LPL Supabase (required for accounts, trips, adventures)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL
NEXT_PUBLIC_SITE_URL=https://immerse.unitedundergod.org

# Optional: RIDB API Key (preferred federal inventory + facility media when present)
# Free: https://ridb.recreation.gov → Profile → API Keys
# Put it here for local dev, OR in Vercel → Project "immerse" → Settings →
# Environment Variables → name RIDB_API_KEY (Production + Preview + Development).
# Or paste the key in chat and an agent will set Vercel for you.
# Without it, live search still works via Recreation.gov public API (with photos).
RIDB_API_KEY=

# Optional: Mapbox (maps + future drive-from-me)
# https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: future AI itinerary features
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
